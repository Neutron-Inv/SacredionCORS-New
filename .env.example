APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

CORS_FTP_HOST=
CORS_FTP_PORT=21
CORS_FTP_USER=
CORS_FTP_PASSWORD=
CORS_FTP_PASSIVE=true
CORS_FTP_ROOT=/RINEX_1_2
CORS_RETENTION_MONTHS=3
CORS_SYNC_DAYS=2
SOGPOS_GOOGLE_PLAY_URL=
DEPLOY_SECRET=
RECAPTCHA_SITE_KEY=6LcAkeElAAAAACblQaJ2NXlV4Mu6aIB40XRKJ9TC
RECAPTCHA_SECRET_KEY=6LcAkeElAAAAAGPbSE2BDRFk25jE6BDSDW9L1HTZ

# 24-hour merged RINEX. Price is in naira (or CORS_24H_CURRENCY major units).
CORS_24H_PRICE=5000
CORS_24H_CURRENCY=NGN
CORS_24H_DOWNLOAD_DAYS=7
CORS_24H_TIMEZONE=Africa/Lagos
# Thin matching observation files to this interval, in seconds. 0 keeps every epoch.
CORS_24H_INTERVAL=30
# Suffix of the extensions to thin. "o" matches .26o.
CORS_24H_SHORTEN_EXTENSIONS=o
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Keep this above the merge job timeout (1800 seconds).
DB_QUEUE_RETRY_AFTER=1860
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.sacredioncors.com
MAIL_PORT=465
MAIL_USERNAME=admin@sacredioncors.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=admin@sacredioncors.com
MAIL_FROM_NAME="Sacredion CORS"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
